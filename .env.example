# 复制为 .env.local 后填入实际值

# ─── /api/interpret (luận giải AI, đã có sẵn trong repo này) ───
# Chọn nhà cung cấp: anthropic | cli. Không đặt thì dùng anthropic nếu có ANTHROPIC_API_KEY; thiếu cấu hình thì API trả 503.
# INTERPRET_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key
# INTERPRET_MODEL=claude-sonnet-5
#
# Dùng Claude CLI (chỉ chạy cục bộ, dùng phiên đăng nhập `claude` của chính máy này, không dùng cho server công khai):
# INTERPRET_PROVIDER=cli
# Windows: trỏ thẳng tới claude.exe vì không spawn được claude.cmd khi không qua shell
# CLAUDE_CLI_PATH=C:\Users\<you>\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
# INTERPRET_CLI_CONCURRENCY=2
#
# Giới hạn số yêu cầu mỗi phút (mặc định 20). Chỉ đặt INTERPRET_TRUST_PROXY=1 khi đứng sau reverse proxy tin cậy
# (khi đó mới đọc X-Forwarded-For để tách người dùng; nếu không, mọi người dùng chung một xô giới hạn).
# INTERPRET_RATE_LIMIT=20
# INTERPRET_TRUST_PROXY=1

# ─── AI 推理（OpenAI 兼容协议，任选一家）───
# 注意：下面这组 OpenAI 兼容配置只给 /api/heming 等你自己实现的接口用，/api/interpret 不读它们；
# 只想排盘、看命盘的话不用填。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key

# ─── 或用其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
